# Copy to .env for local development. NEVER commit .env or real secrets.
DATABASE_URL=sqlite:///WebIntelXAI.db

# Used for pseudonymising IPs / user ids. Set a long random value in any shared deployment.
PRIVACY_SALT=change-me-to-a-long-random-string
# none | truncate | hash   (PRD: "IP address or privacy-safe representation")
IP_PRIVACY_MODE=none

INGEST_RATE_LIMIT_PER_MIN=600
INGEST_MAX_BATCH_SIZE=100
AUTH_TOKEN_TTL_HOURS=24
TRUST_FORWARDED_FOR=false
# Public URL of the FastAPI backend, used in the SDK snippet (falls back to the request URL)
PUBLIC_BASE_URL=
# Allows loading clearly-labelled synthetic demo events via the API
ENABLE_DEMO_LOADER=true

# Used from later milestones (kept configurable per PRD section 41)
GROQ_API_KEY=
LLM_PROVIDER=groq
# Reasoning model (investigation / response agents) and fast model (PRD section 27). Groq retired llama-3.1-8b-instant and
# llama-3.3-70b-versatile on 2026-08-16; verify current model ids at https://console.groq.com/docs/models before the demo.
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# Milestone 8: agent / orchestration knobs (PRD section 41)
AGENTS_CONFIG_PATH=config/agents.yaml
# Reputation provider for IPs/domains: otx (needs TI_API_KEY from an OTX account) | synthetic_demo (clearly labelled fake demo data) | empty = not configured
TI_PROVIDER=
TI_API_KEY=
# Milestone 7: risk scoring weights and level thresholds (PRD section 41)
RISK_CONFIG_PATH=config/risk.yaml

# Milestone 3: deterministic detection (thresholds live in the YAML file; PRD section 33)
DETECTION_CONFIG_PATH=config/detection.yaml
# Run the rules for the affected sources after each ingested batch (never blocks ingestion on failure)
AUTO_DETECT_ON_INGEST=true

# Milestone 4: session anomaly model (Isolation Forest; thresholds live in the YAML file)
ANOMALY_CONFIG_PATH=config/anomaly.yaml
CORRELATION_CONFIG_PATH=config/correlation.yaml

# Milestone 6: threat-intelligence enrichment (knobs live in the YAML file)
THREAT_INTEL_CONFIG_PATH=config/threat_intel.yaml
# Optional NVD API key (raises the CVE lookup rate limit); works without it at a lower limit
NVD_API_KEY=

# Milestone 9: where the Streamlit dashboard finds the FastAPI backend (no secret; not read by the backend)
WEBINTELX_API_URL=http://127.0.0.1:8000

# Milestone 10 Part 2 (dashboard/deploy; no secret, not read by the backend)
# Streamlit Community Cloud runs ONE process: set true to start the unchanged FastAPI app inside it (127.0.0.1 only; demo/synthetic data).
# Real browser-SDK telemetry needs a separately hosted backend (Dockerfile) and WEBINTELX_API_URL instead. See README "Deploy".
WEBINTELX_EMBEDDED_BACKEND=false
WEBINTELX_EMBEDDED_PORT=8000
