# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Community Cloud "Secrets" box.
# secrets.toml itself is git-ignored and must never be committed.

# --- Option A (single Streamlit app, demo with SYNTHETIC data): run the FastAPI backend inside the Streamlit process ---
WEBINTELX_EMBEDDED_BACKEND = "true"
GROQ_API_KEY = ""
PRIVACY_SALT = ""          # set a long random value
# Optional: TI_PROVIDER = "synthetic_demo"   (clearly-labelled fake threat intel)  or  "otx" + TI_API_KEY
# Optional: LLM_MODEL = "openai/gpt-oss-120b"   LLM_FAST_MODEL = "openai/gpt-oss-20b"   (verify current ids at console.groq.com/docs/models)

# --- Option B (backend hosted separately, e.g. from the Dockerfile): point the dashboard at it and leave embedded mode off ---
# WEBINTELX_API_URL = "https://your-backend.example.com"
